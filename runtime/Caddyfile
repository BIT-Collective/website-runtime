{
	admin off
	auto_https off
}

# TLS macht Traefik (Coolify-Proxy) davor, der Container spricht nur HTTP.
:80 {
	# Healthcheck vor der Auth, damit Coolify ihn auch im Staging erreicht.
	# Meldet die laufende Version (IMAGE_TAG kommt aus der Compose-Ressource),
	# damit bit-deploy erkennt, ob wirklich der neue Build laeuft.
	handle /healthz {
		header Content-Type application/json
		header Cache-Control no-store
		respond `\{"status":"ok","version":"{$IMAGE_TAG:unbekannt}"\}` 200
	}

	# Website-eigene Routen (z. B. handle /api/kontakt) — die Website legt sie per
	# COPY nach /etc/caddy/site.d/. Leerer Ordner = keine Aenderung.
	import /etc/caddy/site.d/*.caddy

	handle {
		import /etc/caddy/mode-{$SITE_MODE}.caddy

		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}

		# Gehashte Assets duerfen lange gecacht werden, alles andere nicht.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		root * /srv
		# SPA-Fallback: /leistungen & Co. kennt nur der React-Router.
		try_files {path} /index.html
		file_server
	}

	encode zstd gzip
	# Zugriffslog mit voller IP, max. 7 Tage (so steht es in den Datenschutzerklaerungen):
	# taeglich neue Datei, rotierte Dateien nach 6 Tagen geloescht. Liegt nur im Container,
	# ein Redeploy loescht es zusaetzlich.
	log {
		output file /var/log/caddy/access.log {
			roll_interval 24h
			roll_keep_for 144h
			roll_keep 7
		}
		format json
	}
}
